+#[tokio::test]
+async fn live_handoff_refuses_pending_prompt_before_touching_runtime() {
+    let mut server = test_headless_server();
+    server.app.state.workspaces = vec![crate::workspace::Workspace::test_new("reserved")];
+    server.app.state.ensure_test_terminals();
+    let terminal = server.app.state.terminals.values_mut().next().unwrap();
+    terminal.reserve_agent_prompt(Instant::now());
+    let socket = server.client_socket_path.clone();
+    let error = server.perform_live_handoff(Default::default()).unwrap_err();
+    assert!(error
+        .to_string()
+        .contains("prompt is awaiting observed activity"));
+    assert!(!server.handoff_in_progress);
+    assert!(
+        socket.exists(),
+        "rejection must leave the existing listener intact"
+    );
+    assert_eq!(server.app.state.workspaces.len(), 1);
+    assert!(server
+        .app
+        .state
+        .terminals
+        .values()
+        .next()
+        .unwrap()
+        .agent_prompt_pending());
+}
